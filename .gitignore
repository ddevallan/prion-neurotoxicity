# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# MD simulation output (large binary files)
md_output/
md_membrane_output/
*.dcd
*.chk

# uv lock (reproducible but large)
uv.lock

# Analysis output in root (regenerable from scripts)
/*.json

# Keep analysis results in docs
!docs/analysis/*.json

# CHARMM-GUI large files (regenerable)
charmm_gui_membrane/*/toppar/
charmm_gui_membrane/*/*.tar.gz
charmm_gui_membrane/*/*.crd
charmm_gui_membrane/*/*.psf

# Membrane system build outputs (regenerable)
membrane_systems/*.pdb
membrane_systems/*.xml
!membrane_systems/run_vastai.py

# Claude internal
.claude/
